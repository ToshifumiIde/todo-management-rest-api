<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.ti.todo.domain.dao.RoleMapper">
    <select id="getRoleByName" resultType="net.ti.todo.domain.entity.Role">
        SELECT id FROM role
        WHERE
        name = #{roleName}
    </select>
</mapper>